{
    "name": "juststeveking/sdk-toolbox",
    "description": "Build PHP SDKs on PSR-18, typed end to end, with the HTTP standards an API client should honour.",
    "keywords": [
        "sdk",
        "api",
        "http",
        "psr-18",
        "psr-17",
        "rfc9457",
        "client"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Steve McDougall",
            "email": "steve@juststeveking.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "php-http/discovery": "^1.20",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-client": "^1.0.3",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "cuyz/valinor": "^2.6",
        "laravel/pint": "^1.25",
        "nyholm/psr7": "^1.8",
        "open-telemetry/api": "^1.10",
        "open-telemetry/sdk": "^1.15",
        "pestphp/pest": "^4.1",
        "phpstan/phpstan": "^2.1",
        "symfony/http-client": "^7.4 || ^8.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 client, if your application doesn't already have one.",
        "symfony/http-client": "A PSR-18 client, if your application doesn't already have one.",
        "psr/simple-cache": "To share rate-limit state between processes with Psr16RateLimitStore.",
        "cuyz/valinor": "To map responses to typed objects with ValinorHydrator.",
        "open-telemetry/api": "For OpenTelemetrySpans: a client span per attempt, and trace context from it."
    },
    "autoload": {
        "psr-4": {
            "JustSteveKing\\SdkToolbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustSteveKing\\SdkToolbox\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test"
    }
}
